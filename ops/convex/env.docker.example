# Template for ops/convex/.env.docker (gitignored) — the Convex backend
# container env of THIS machine's deployment (dev-only project). Copy and fill:
#
#   cp ops/convex/env.docker.example ops/convex/.env.docker
#
# Host ports are fixed in the quadlets: backend 3230/3231, dashboard 6793
# (in-container always 3210/3211/6791).

CONVEX_CLOUD_ORIGIN=https://convex.convex-auth.dev
CONVEX_SITE_ORIGIN=https://api.convex-auth.dev
NEXT_PUBLIC_DEPLOYMENT_URL=https://convex.convex-auth.dev

INSTANCE_NAME=dev
INSTANCE_SECRET=<64-hex-chars>
DISABLE_BEACON='true'
