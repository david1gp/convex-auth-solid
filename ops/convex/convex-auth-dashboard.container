# Self-hosted Convex dashboard (Podman Quadlet).
# Quadlet turns this into `convex-auth-dashboard.service` on `daemon-reload`.
[Unit]
Description=convex-auth-solid Convex dashboard (Podman Quadlet)
# = compose `depends_on: backend: condition: service_healthy` (see Notify=healthy
# on the backend). Requires= pulls the backend in; After= orders us after it.
After=convex-auth-backend.service
Requires=convex-auth-backend.service

[Container]
ContainerName=convex-auth-dashboard
Image=ghcr.io/get-convex/convex-dashboard:latest
AutoUpdate=registry
# Dashboard listens on 6791 in-container; 6791/6792 are taken by allgroups/dcc
# on the host, publish as 6793 (dash.convex-auth.dev proxies to it).
PublishPort=127.0.0.1:6793:6791
EnvironmentFile=%h/convex-auth-solid/ops/convex/.env.docker

[Service]
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
